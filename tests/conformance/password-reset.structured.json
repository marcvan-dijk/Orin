{
  "modelVersion": "0.1.0",
  "module": {
    "id": "account.password-reset/module",
    "kind": "module",
    "name": "account.password-reset",
    "status": "accepted",
    "purpose": "Let a person recover an account without revealing whether it exists.",
    "context": {
      "repository": "Orin",
      "risk": "Account enumeration and reset-token abuse"
    },
    "implementationPolicies": {
      "optimize-for": "low-latency",
      "prefer": "managed-services",
      "require": "relational-persistence",
      "deploy-to": "existing-infrastructure"
    },
    "imports": [
      "account-store",
      "email-provider"
    ]
  },
  "objects": [
    {
      "id": "account.password-reset/capability/person.request-password-reset",
      "kind": "capability",
      "name": "person.request-password-reset",
      "status": "accepted"
    },
    {
      "id": "account.password-reset/capability/system.send-reset-message",
      "kind": "capability",
      "name": "system.send-reset-message",
      "status": "accepted"
    },
    {
      "id": "account.password-reset/evidence/blocked",
      "kind": "evidence",
      "name": "blocked",
      "status": "blocked",
      "statement": "The rate-limit decision is unresolved."
    },
    {
      "id": "account.password-reset/example/registered-address",
      "kind": "example",
      "name": "registered-address",
      "status": "accepted",
      "claims": [
        "An account exists for the requested email.",
        "The person requests a password reset.",
        "The system sends a reset message and returns the standard confirmation."
      ]
    },
    {
      "id": "account.password-reset/example/unknown-address",
      "kind": "example",
      "name": "unknown-address",
      "status": "accepted",
      "claims": [
        "No account exists for the requested email.",
        "The person requests a password reset.",
        "The system returns the same standard confirmation without revealing account existence."
      ]
    },
    {
      "id": "account.password-reset/rule/reset-token-expiry",
      "kind": "rule",
      "name": "reset-token-expiry",
      "status": "accepted",
      "claims": [
        "Reset tokens expire after 15 minutes."
      ]
    },
    {
      "id": "account.password-reset/rule/reset-token-single-use",
      "kind": "rule",
      "name": "reset-token-single-use",
      "status": "accepted",
      "claims": [
        "Reset tokens are single-use."
      ]
    },
    {
      "id": "account.password-reset/state/account-exists",
      "kind": "state",
      "name": "account-exists",
      "status": "accepted"
    },
    {
      "id": "account.password-reset/state/reset-requested",
      "kind": "state",
      "name": "reset-requested",
      "status": "accepted"
    },
    {
      "id": "account.password-reset/state/reset-token-issued",
      "kind": "state",
      "name": "reset-token-issued",
      "status": "accepted"
    },
    {
      "id": "account.password-reset/uncertainty/rate-limit",
      "kind": "uncertainty",
      "name": "rate-limit",
      "status": "unresolved",
      "claims": [
        "What rate limit applies per address and network origin?"
      ],
      "consequential": true,
      "authority": "human"
    },
    {
      "id": "account.password-reset/value-type/email",
      "kind": "value-type",
      "name": "email",
      "status": "accepted"
    },
    {
      "id": "account.password-reset/value-type/reset-token",
      "kind": "value-type",
      "name": "reset-token",
      "status": "accepted"
    },
    {
      "id": "account.password-reset/workflow/request-reset",
      "kind": "workflow",
      "name": "request-reset",
      "status": "accepted",
      "inputs": [
        "email"
      ],
      "requires": [
        "account.password-reset/capability/person.request-password-reset"
      ],
      "claims": [
        "Registered and unknown addresses receive indistinguishable responses.",
        "No account state is disclosed when delivery is unavailable."
      ]
    }
  ]
}
