        },
        {
          "name": "title",
          "type": "shared-tasks/value-type/task-title"
        }
      ]
    },
    {
      "id": "shared-tasks/relation/assigned-to",
      "kind": "relation",
      "name": "assigned-to",
      "status": "accepted",
