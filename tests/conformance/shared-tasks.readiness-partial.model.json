{
  "modelVersion": "0.1.0",
  "module": {
    "id": "shared-tasks/module",
    "kind": "module",
    "name": "shared-tasks",
    "status": "accepted",
    "implementationPolicies": {
      "optimize-for": "simplicity"
    }
  },
  "objects": [
    {
      "id": "shared-tasks/value-type/person-id",
      "kind": "value-type",
      "name": "person-id",
      "status": "accepted"
    },
    {
      "id": "shared-tasks/value-type/task-id",
      "kind": "value-type",
      "name": "task-id",
      "status": "accepted"
    },
    {
      "id": "shared-tasks/value-type/task-title",
      "kind": "value-type",
      "name": "task-title",
      "status": "accepted"
    },
    {
      "id": "shared-tasks/entity-type/person",
      "kind": "entity-type",
      "name": "person",
      "status": "accepted",
      "fields": [
        {
          "name": "id",
          "type": "shared-tasks/value-type/person-id",
          "identity": true
        }
      ]
    },
    {
      "id": "shared-tasks/entity-type/task",
      "kind": "entity-type",
      "name": "task",
