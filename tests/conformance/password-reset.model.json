{
  "modelVersion": "0.1.0",
  "module": {
    "id": "account.password-reset/module",
    "kind": "module",
    "name": "account.password-reset",
    "status": "accepted",
    "purpose": "Let a person recover an account without revealing whether it exists."
  },
  "objects": [
    {
      "id": "account.password-reset/value-type/email",
      "kind": "value-type",
      "name": "email"
    },
    {
      "id": "account.password-reset/value-type/reset-token",
      "kind": "value-type",
      "name": "reset-token"
    },
    {
      "id": "account.password-reset/state/account-exists",
      "kind": "state",
      "name": "account-exists"
    },
    {
      "id": "account.password-reset/state/reset-requested",
      "kind": "state",
      "name": "reset-requested"
    },
    {
      "id": "account.password-reset/state/reset-token-issued",
      "kind": "state",
      "name": "reset-token-issued"
    },
    {
      "id": "account.password-reset/capability/person.request-password-reset",
      "kind": "capability",
      "name": "person.request-password-reset"
    },
    {
      "id": "account.password-reset/capability/system.send-reset-message",
      "kind": "capability",
      "name": "system.send-reset-message"
    },
    {
      "id": "account.password-reset/effect/account-store.lookup",
      "kind": "effect",
      "name": "account-store.lookup",
      "requires": ["account.password-reset/capability/person.request-password-reset"]
    },
    {
      "id": "account.password-reset/effect/email-provider.send-reset-message",
      "kind": "effect",
      "name": "email-provider.send-reset-message",
      "requires": ["account.password-reset/capability/system.send-reset-message"]
    },
    {
      "id": "account.password-reset/rule/response-does-not-disclose-account",
      "kind": "rule",
      "name": "response-does-not-disclose-account",
      "claims": ["Registered and unknown addresses receive indistinguishable responses."]
    },
    {
      "id": "account.password-reset/rule/reset-token-expiry",
      "kind": "rule",
      "name": "reset-token-expiry",
      "claims": ["Reset tokens expire after 15 minutes."]
    },
    {
      "id": "account.password-reset/rule/reset-token-single-use",
      "kind": "rule",
      "name": "reset-token-single-use",
      "claims": ["Reset tokens are single-use."]
    },
    {
      "id": "account.password-reset/workflow/request-reset",
      "kind": "workflow",
      "name": "request-reset"
    },
    {
      "id": "account.password-reset/example/registered-address",
      "kind": "example",
      "name": "registered-address",
      "demonstrates": ["account.password-reset/workflow/request-reset"],
      "expects": ["standard-confirmation", "reset-message-sent"]
    },
    {
      "id": "account.password-reset/example/unknown-address",
      "kind": "example",
      "name": "unknown-address",
      "demonstrates": ["account.password-reset/workflow/request-reset"],
      "expects": ["standard-confirmation", "reset-message-not-sent"]
    },
    {
      "id": "account.password-reset/uncertainty/rate-limit",
      "kind": "uncertainty",
      "name": "rate-limit",
      "consequential": true,
      "question": "What rate limit applies per address and network origin?",
      "authority": "human"
    }
  ],
  "unresolved": ["account.password-reset/uncertainty/rate-limit"]
