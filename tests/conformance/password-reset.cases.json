{
  "fixtureVersion": "0.1.0",
  "workflow": "account.password-reset/workflow/request-reset",
  "cases": [
    {
      "id": "account.password-reset/case/registered-address",
      "given": { "accountExists": true, "emailProvider": "available" },
      "when": { "action": "request-password-reset" },
      "then": {
        "response": "standard-confirmation",
        "resetMessage": "sent"
      }
    },
    {
      "id": "account.password-reset/case/unknown-address",
      "given": { "accountExists": false, "emailProvider": "available" },
      "when": { "action": "request-password-reset" },
      "then": {
        "response": "standard-confirmation",
        "resetMessage": "not-sent",
        "accountExistenceDisclosed": false
      }
    },
    {
      "id": "account.password-reset/case/delivery-unavailable",
      "given": { "accountExists": true, "emailProvider": "unavailable" },
      "when": { "action": "request-password-reset" },
      "then": {
        "accountExistenceDisclosed": false,
        "recovery": "no-account-state-disclosed"
      }
    },
    {
      "id": "account.password-reset/case/account-store-unavailable",
      "given": { "accountExists": true, "accountStore": "unavailable" },
      "when": { "action": "request-password-reset" },
      "then": {
        "response": "standard-confirmation",
        "recovery": "no-account-state-disclosed",
        "accountExistenceDisclosed": false
      }
    },
    {
      "id": "account.password-reset/case/duplicate-requests",
      "given": { "accountExists": true, "emailProvider": "available" },
      "when": { "action": "request-password-reset-twice" },
      "then": {
        "tokensDistinct": true,
        "responses": ["standard-confirmation", "standard-confirmation"]
      }
    },
    {
      "id": "account.password-reset/case/concurrent-requests",
      "given": {
        "accountExists": true,
        "emails": ["person@example.com", "person@example.com"]
      },
      "when": { "action": "request-password-reset-concurrently" },
      "then": {
        "tokensDistinct": true,
        "responses": ["standard-confirmation", "standard-confirmation"]
      }
    },
    {
      "id": "account.password-reset/case/expired-token",
      "given": { "accountExists": true },
      "when": { "action": "redeem-expired-token" },
      "then": { "token": "rejected", "reason": "token expired" }
    },
    {
      "id": "account.password-reset/case/reused-token",
      "given": { "accountExists": true },
      "when": { "action": "redeem-token-twice" },
      "then": { "token": "rejected", "reason": "token already used" }
    },
    {
      "id": "account.password-reset/case/unresolved-rate-limit",
      "given": {
        "uncertainty": "account.password-reset/uncertainty/rate-limit"
      },
      "when": { "action": "compile" },
      "then": { "compilation": "blocked" }
    }
  ]
}
