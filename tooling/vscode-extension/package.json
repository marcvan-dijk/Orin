{
  "name": "orin-language",
  "displayName": "Orin Language",
  "description": "Syntax support and semantic checks for Orin files.",
  "version": "0.0.1",
  "publisher": "orin",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:orin"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Syntax highlighting, outline and hover work in untrusted workspaces. The Orin agent and checker run Python from the workspace and are disabled until the workspace is trusted.",
      "restrictedConfigurations": [
        "orin.pythonPath"
      ]
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "orin",
        "aliases": [
          "Orin",
          "orin"
        ],
        "extensions": [
          ".orin"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "orin",
        "scopeName": "source.orin",
        "path": "./syntaxes/orin.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Orin",
      "properties": {
        "orin.pythonPath": {
          "type": "string",
          "default": "python",
          "scope": "machine",
          "description": "Python executable used to run the Orin agent (python -m tooling.python.orin_agent)."
        }
      }
    },
    "menus": {
      "commandPalette": [
        { "command": "orin.showDecisionOptions", "when": "false" }
      ]
    },
    "commands": [
      {
        "command": "orin.showDecisionOptions",
        "title": "Show decision options",
        "category": "Orin"
      },
      {
        "command": "orin.analyzeCurrentFile",
        "title": "Orin: Analyze Current File",
        "category": "Orin"
      },
      {
        "command": "orin.inspectWithAgent",
        "title": "Orin: Inspect with Orin Agent",
        "category": "Orin"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "test": "tsc -p ./ && node out/orinModel.test.js",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.140.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.0.0"
  }
}
