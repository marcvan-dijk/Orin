{
  "scopeName": "source.orin",
  "patterns": [
    { "include": "#comments" },
    { "include": "#section" },
    { "include": "#list-item" },
    { "include": "#strings" },
    { "include": "#values" }
  ],
  "repository": {
    "comments": {
      "patterns": [{ "match": "//.*$", "name": "comment.line.double-slash.orin" }]
    },
    "section": {
      "patterns": [
        {
          "match": "^(\\s*)(module|purpose|context|import|type|state|capability|effect|rules|rule|workflow|example|uncertainty|decision|target|evidence|policy|implementation|input|output|steps|given|when|then|always|requires|authority|question|status|options|answer|option|claims|why-it-matters|affects|label|explanation|effects|impact|rule-claims|compilation|expects|imports|policies)(:)(?:[ \\t]+([^\\s/][^\\n]*?))?[ \\t]*$",
          "captures": {
            "2": { "name": "keyword.control.orin" },
            "3": { "name": "punctuation.separator.key-value.orin" },
            "4": { "name": "entity.name.type.orin" }
          }
        },
        {
          "match": "^(\\s*)([A-Za-z_][A-Za-z0-9_-]*)(:)[ \\t]+(yes|no|true|false)\\b",
          "captures": {
            "2": { "name": "variable.other.property.orin" },
            "3": { "name": "punctuation.separator.key-value.orin" },
            "4": { "name": "constant.language.boolean.orin" }
          }
        }
      ]
    },
    "list-item": {
      "match": "^\\s*(-)(?=\\s)",
      "captures": { "1": { "name": "punctuation.definition.list.begin.markdown.orin" } }
    },
    "strings": {
      "name": "string.quoted.double.orin",
      "begin": "\"",
      "end": "\"",
      "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.orin" }]
    },
    "values": {
      "patterns": [
        { "match": "\\b(yes|no|true|false)\\b", "name": "constant.language.boolean.orin" },
        { "match": "\\b\\d+(?:\\.\\d+)?\\b", "name": "constant.numeric.orin" }
      ]
    }
  }
}
