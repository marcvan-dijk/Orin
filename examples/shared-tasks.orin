module shared-tasks {
  purpose "People can share and complete tasks with controlled access."
  import persistent-entity-store

  type person-id
  type list-name
  type task-id
  type task-title

  entity person {
    field id person-id identity
  }

  entity task-list {
    field id task-id identity
    field name list-name
  }

  entity task {
    field id task-id identity
    field title task-title
  }

  relation member-of {
    from person
    to task-list
    cardinality many-to-many
  }

  state open
  state completed
  capability complete-task
  capability write-task-state

  effect persistent-entity-store.write.task-state {
    requires write-task-state
    durability strong
  }

  workflow complete-task {
    input actor person
    input task task
    output task task
    actor actor
    requires complete-task
    uses persistent-entity-store.write.task-state
    bind actor complete-task
    bind actor write-task-state
    transition open -> completed
  }
}