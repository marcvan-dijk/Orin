module account.password-reset {
  purpose "Let a person recover an account without revealing whether it exists."

  context {
    repository "Orin"
    risk "Account enumeration and reset-token abuse"
  }

  import account-store
  import email-provider

  scope {
    includes "Password-reset request behavior"
    excludes "Email-provider selection and account recovery UI"
  }

  type email
  type reset-token

  state account-exists
  state reset-requested
  state reset-token-issued

  capability person.request-password-reset
  capability system.send-reset-message

  rule reset-token-expiry {
    guarantee "Reset tokens expire after 15 minutes."
  }

  rule reset-token-single-use {
    guarantee "Reset tokens are single-use."
  }

  risk account-takeover {
    impact "Account takeover or account enumeration"
    severity high
  }

  role human owns "Goal, constraints, and acceptance decision"
  role ai may "Propose changes and run delegated checks"

  workflow request-reset {
    input email
    requires person.request-password-reset
    outcome "Registered and unknown addresses receive indistinguishable responses."
    recovery "No account state is disclosed when delivery is unavailable."
  }

  example registered-address {
    given "An account exists for the requested email."
    when "The person requests a password reset."
    then "The system sends a reset message and returns the standard confirmation."
  }

  example unknown-address {
    given "No account exists for the requested email."
    when "The person requests a password reset."
    then "The system returns the same standard confirmation without revealing account existence."
  }

  uncertainty rate-limit {
    question "What rate limit applies per address and network origin?"
    authority human
  }

  target implementation-independent {
    budget response-time "Defined by the human before release."
  }

  evidence blocked "The rate-limit decision is unresolved."
}